# Local development is started with `npm start` and forces NODE_ENV=development + LOCAL_AUTH=true.
# Do not enable LOCAL_AUTH in production.
NODE_ENV=development
LOCAL_AUTH=true
PORT=4000
FRONTEND_URL=http://localhost:4000

# Optional local MongoDB / Mongo Atlas. Development falls back to memory if omitted.
MONGODB_URI=
MONGODB_DB_NAME=skillbridge

# Required for production Firebase Admin verification.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
